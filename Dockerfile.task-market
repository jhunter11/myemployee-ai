FROM node:22-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS build

WORKDIR /service
COPY package.json package-lock.json tsconfig.json tsconfig.task-market.json ./
RUN npm ci
COPY src/task-market ./src/task-market
RUN npm run taskmarket:build

FROM node:22-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS runtime

ENV NODE_ENV=production \
    TASK_MARKET_HOST=0.0.0.0 \
    TASK_MARKET_PORT=4021 \
    TASK_MARKET_SETTLEMENT_LEDGER_PATH=/var/lib/jarvis-task-market/settlements.sqlite
WORKDIR /service
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /service/dist-task-market ./dist-task-market
COPY deploy/task-market/facilitator-relay.mjs ./facilitator-relay.mjs
RUN mkdir -p /var/lib/jarvis-task-market \
    && chown node:node /var/lib/jarvis-task-market \
    && chmod 0700 /var/lib/jarvis-task-market
USER node
EXPOSE 4021
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:4021/readyz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node", "dist-task-market/seller-server.js"]
