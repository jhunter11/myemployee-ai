# Loopback gateway
HOST="127.0.0.1"
PORT=3000

# Mutable local state (defaults shown)
DB_PATH="./data/jarvis.sqlite"
JARVIS_CLIENT_ROOT="./clients"
JARVIS_WORKSPACE_ROOT="./workspaces"
JARVIS_GRAPH_ROOT="./memory/graph"
JARVIS_PERSONAL_MEMORY_ROOT="./memory/personal"

# Which memory backend `createMemorySystem` binds. Unset or unrecognized values
# resolve to `flat`, so a typo never silently changes retrieval behaviour.
#   flat_untyped   EXPERIMENT CONTROL ONLY — returns superseded and expired facts
#                  by design. Never set this outside a bench run.
#   flat           default: one store, temporally-filtered lexical retrieval
#   typed_hybrid   CoALA store classes + per-store re-ranking
#   typed_temporal typed_hybrid + validity-window reasoning and stale suppression
#   ledger         event-sourced bitemporal revisions behind the flat read path
JARVIS_MEMORY_BACKEND="flat"

# Start paused unless the operator intentionally chooses the existing active posture.
JARVIS_AGENCY_INITIAL_POSTURE="paused"

# Model execution remains OFF in the durable operator-owned enablement record.
# Do not place provider API keys in this file. Subscription credentials are read
# from the macOS Keychain or the documented provider OAuth stores.
# Optional trusted absolute CLI locations. The runtime also checks the fixed
# per-user Claude location and the Codex binary bundled with ChatGPT.app.
JARVIS_CLAUDE_CLI="/Users/your-user/.local/bin/claude"
JARVIS_CODEX_CLI="/Applications/ChatGPT.app/Contents/Resources/codex"

# Telegram is also off by default. Configure its private principal and Keychain
# identifiers through the reviewed operations installer, not this example file.
JARVIS_TELEGRAM_ENABLED="0"

# Content-provider connections (faceless-content pipeline). Free/local providers
# (macOS `say`, generated title cards) need nothing. The credentialed ones stay
# inert until a key is connected via one of these env vars OR the macOS Keychain
# (service ai-agency-jarvis.<provider>, account api-key). Prefer the Keychain so
# the secret never lands in a committed file. Inspect with `npm run content:connections`.
# See docs/operations/content-connections.md.
#   PEXELS_API_KEY=          # free stock B-roll
#   ELEVENLABS_API_KEY=      # premium narration (metered)
#   HIGGSFIELD_API_KEY=      # premium cinematic visuals (subscription)
