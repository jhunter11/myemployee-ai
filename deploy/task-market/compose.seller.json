{
  "name": "jarvis-task-market-seller",
  "services": {
    "tls_proxy": {
      "image": "${TASK_MARKET_PROXY_IMAGE:?Set TASK_MARKET_PROXY_IMAGE to an immutable nginx image digest}",
      "pull_policy": "always",
      "entrypoint": ["/usr/sbin/nginx"],
      "command": ["-g", "daemon off; pid /tmp/nginx.pid;"],
      "user": "101:101",
      "read_only": true,
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "init": true,
      "privileged": false,
      "pids_limit": 64,
      "mem_limit": "128m",
      "cpus": 0.25,
      "oom_kill_disable": false,
      "ports": [
        { "target": 8443, "published": "443", "protocol": "tcp", "host_ip": "0.0.0.0" }
      ],
      "networks": {
        "proxy_ingress": {},
        "seller_ingress": { "ipv4_address": "172.30.0.2" }
      },
      "configs": [
        {
          "source": "seller_proxy",
          "target": "/etc/nginx/conf.d/default.conf",
          "mode": 292
        }
      ],
      "secrets": [
        {
          "source": "seller_tls_certificate",
          "target": "/run/secrets/seller_tls_certificate",
          "uid": "101",
          "gid": "101",
          "mode": 292
        },
        {
          "source": "seller_tls_private_key",
          "target": "/run/secrets/seller_tls_private_key",
          "uid": "101",
          "gid": "101",
          "mode": 256
        }
      ],
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,nodev,size=4m,mode=1777",
        "/var/cache/nginx:rw,noexec,nosuid,nodev,size=16m,mode=0750,uid=101,gid=101"
      ],
      "restart": "unless-stopped",
      "stop_grace_period": "10s",
      "healthcheck": {
        "test": [
          "CMD",
          "nc",
          "-z",
          "-w",
          "2",
          "127.0.0.1",
          "8443"
        ],
        "interval": "30s",
        "timeout": "5s",
        "start_period": "10s",
        "retries": 3
      },
      "ulimits": {
        "core": 0,
        "nofile": { "soft": 512, "hard": 512 }
      },
      "logging": {
        "driver": "json-file",
        "options": { "max-size": "10m", "max-file": "3" }
      }
    },
    "seller": {
      "image": "${TASK_MARKET_SELLER_IMAGE:?Set TASK_MARKET_SELLER_IMAGE to an immutable image digest}",
      "pull_policy": "always",
      "user": "1000:1000",
      "read_only": true,
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "init": true,
      "privileged": false,
      "pids_limit": 128,
      "mem_limit": "512m",
      "cpus": 1,
      "oom_kill_disable": false,
      "extra_hosts": ["x402.org:172.30.0.10"],
      "networks": {
        "seller_ingress": { "ipv4_address": "172.30.0.3" },
        "seller_facilitator": { "ipv4_address": "172.30.0.11" }
      },
      "volumes": [
        {
          "type": "volume",
          "source": "seller_settlements",
          "target": "/var/lib/jarvis-task-market",
          "read_only": false
        }
      ],
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,nodev,size=16m,mode=1777",
        "/run:rw,noexec,nosuid,nodev,size=1m,mode=0755"
      ],
      "environment": {
        "NODE_ENV": "production",
        "TASK_MARKET_MODE": "testnet",
        "TASK_MARKET_NETWORK": "eip155:84532",
        "TASK_MARKET_FACILITATOR_URL": "https://x402.org/facilitator",
        "TASK_MARKET_PAY_TO": "${TASK_MARKET_PAY_TO:?Set the public Base Sepolia receive address}",
        "TASK_MARKET_PRICE": "${TASK_MARKET_PRICE:?Set the bounded testnet price}",
        "TASK_MARKET_PUBLIC_BASE_URL": "${TASK_MARKET_PUBLIC_BASE_URL:?Set the public TLS origin}",
        "TASK_MARKET_HOST": "0.0.0.0",
        "TASK_MARKET_PORT": "4021",
        "TASK_MARKET_ACCEPTING_WORK": "${TASK_MARKET_ACCEPTING_WORK:-false}",
        "TASK_MARKET_SETTLEMENT_LEDGER_PATH": "/var/lib/jarvis-task-market/settlements.sqlite"
      },
      "restart": "unless-stopped",
      "stop_grace_period": "20s",
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:4021/livez').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
        ],
        "interval": "30s",
        "timeout": "5s",
        "start_period": "10s",
        "retries": 3
      },
      "ulimits": {
        "core": 0,
        "nofile": { "soft": 1024, "hard": 1024 }
      },
      "logging": {
        "driver": "json-file",
        "options": { "max-size": "10m", "max-file": "3" }
      }
    },
    "facilitator_relay": {
      "image": "${TASK_MARKET_SELLER_IMAGE:?Set TASK_MARKET_SELLER_IMAGE to an immutable image digest}",
      "pull_policy": "always",
      "command": ["node", "facilitator-relay.mjs"],
      "user": "1000:1000",
      "read_only": true,
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "init": true,
      "privileged": false,
      "pids_limit": 64,
      "mem_limit": "128m",
      "cpus": 0.25,
      "oom_kill_disable": false,
      "sysctls": { "net.ipv4.ip_unprivileged_port_start": "0" },
      "networks": {
        "seller_facilitator": { "ipv4_address": "172.30.0.10" },
        "relay_egress": {}
      },
      "tmpfs": ["/tmp:rw,noexec,nosuid,nodev,size=4m,mode=1777"],
      "restart": "unless-stopped",
      "stop_grace_period": "10s",
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "const s=require('node:net').createConnection(443,'172.30.0.10');s.setTimeout(2000);s.once('connect',()=>{s.destroy();process.exit(0)});s.once('error',()=>process.exit(1));s.once('timeout',()=>process.exit(1))"
        ],
        "interval": "30s",
        "timeout": "5s",
        "start_period": "10s",
        "retries": 3
      },
      "ulimits": {
        "core": 0,
        "nofile": { "soft": 256, "hard": 256 }
      },
      "logging": {
        "driver": "json-file",
        "options": { "max-size": "5m", "max-file": "2" }
      }
    }
  },
  "networks": {
    "proxy_ingress": {
      "driver": "bridge",
      "internal": false
    },
    "seller_ingress": {
      "driver": "bridge",
      "internal": true,
      "ipam": { "config": [{ "subnet": "172.30.0.0/29" }] }
    },
    "seller_facilitator": {
      "driver": "bridge",
      "internal": true,
      "ipam": { "config": [{ "subnet": "172.30.0.8/29" }] }
    },
    "relay_egress": {
      "driver": "bridge",
      "internal": false
    }
  },
  "volumes": {
    "seller_settlements": {
      "name": "jarvis_task_market_seller_settlements",
      "external": true
    }
  },
  "configs": {
    "seller_proxy": {
      "file": "${TASK_MARKET_PROXY_CONFIG_FILE:?Set the rendered TLS proxy configuration file}"
    }
  },
  "secrets": {
    "seller_tls_certificate": {
      "file": "${TASK_MARKET_TLS_CERTIFICATE_FILE:?Set the TLS certificate file}"
    },
    "seller_tls_private_key": {
      "file": "${TASK_MARKET_TLS_KEY_FILE:?Set the TLS private key file}"
    }
  }
}
